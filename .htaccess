
RewriteEngine On

# Block direct access to .env files (Apache 2.4 compliant)
<FilesMatch "^\.env">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Redirect index.php or index to the directory root (/)
RewriteCond %{THE_REQUEST} \s/+(.*?)/?index(\.php)?[\s?] [NC]
RewriteRule ^ /%1/ [R=301,L]

# Redirect /page.php to /page (external redirect)
# Google returns the OAuth authorization response to this exact URL with a
# POST request. Redirecting it would turn the request into a GET and discard
# the authorization fields, causing the account-selection loop.
RewriteCond %{REQUEST_URI} !^/auth/google\.php$ [NC]
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Route clean login/logout URLs directly to the auth/ folder
RewriteRule ^login$ auth/login.php [L,NC]
RewriteRule ^logout$ auth/logout.php [L,NC]
RewriteRule ^register$ auth/register.php [L,NC]
RewriteRule ^signup$ auth/register.php [L,NC]

# Map /page to /page.php internally (internal rewrite)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*?)/?$ $1.php [NC,L]

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php82” package as the default “PHP” programming language.
<IfModule litespeed>
  <IfModule mime_module>
    AddHandler application/x-httpd-ea-php82___lsphp .php .php8 .phtml
  </IfModule>
</IfModule>
# php -- END cPanel-generated handler, do not edit
